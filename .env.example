# ==============================================================================
# EdgeJump 堡垒机 本地部署与环境配置文件示例 (.env.example)
# 使用方法：复制本文件为 .env，并按需填写你的配置项：
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare 核心认证配置 (必须)
# ------------------------------------------------------------------------------
# Cloudflare API 令牌（在 Cloudflare 仪表板 -> 我的个人资料 -> API 令牌 中创建）
# 需具备权限：D1:Edit, Workers KV:Edit, Workers Scripts:Edit, Account Settings:Read
CLOUDFLARE_API_TOKEN=

# Cloudflare 账户 ID (推荐配置；在仪表板右侧栏直接复制)
# 若 Token 仅绑定单个账户且包含账户读取权限可留空自动识别，多账号组织建议明确配置
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 2. 部署与系统模式设置 (可选)
# ------------------------------------------------------------------------------
# 部署模式: production (默认正式模式) | demo (公开演示站模式，锁定管理员密码及录像保留期)
DEPLOY_TYPE=production

# 首次超级管理员初始化引导令牌（首次部署前自行生成并保存；CI 只使用加密 Secret）
BOOTSTRAP_TOKEN=

# 独立会话票据签名密钥（可选；部署时自动生成并写入 Worker Secret）
SESSION_TICKET_SECRET=

# Worker 发布名称 (默认: edgejump)
WORKER_NAME=edgejump

# 自定义访问域名 (可选，例如: bastion.example.com；留空则默认使用 workers.dev 子域)
CUSTOM_DOMAIN=

# D1 关系型数据库名称 (默认: edgejump-db；系统将自动查找或创建)
D1_DATABASE_NAME=edgejump-db

# KV 缓存命名空间名称 (默认: edgejump-kv；系统将自动查找或创建)
KV_NAMESPACE_NAME=edgejump-kv

# ------------------------------------------------------------------------------
# 3. 外部 S3 / Backblaze B2 审计录像对象存储 (可选，费用受存储、请求与流量配额约束)
# 若留空且未开通 R2，系统将以轻量无录像模式运行，所有核心连接与审计功能均不受影响。
# ------------------------------------------------------------------------------
# S3 兼容服务端点 (例如 Backblaze B2 桶详情中的 S3 Endpoint)
S3_ENDPOINT=

# 存储桶名称 (例如: edgejump-recordings)
S3_BUCKET=

# 存储区域 (例如: us-west-004，默认可填 auto)
S3_REGION=auto

# S3 Access Key ID (Backblaze B2 为 keyID)
S3_ACCESS_KEY_ID=

# S3 Secret Access Key (Backblaze B2 为 applicationKey)
S3_SECRET_ACCESS_KEY=
